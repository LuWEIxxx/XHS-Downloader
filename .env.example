# Copy to .env beside docker-compose.yml and set a unique password before starting.
XHS_WEB_USERNAME=admin
# Required: at least 16 characters. Never commit the real .env file.
XHS_WEB_PASSWORD=
# RAM limit for the Docker tmpfs used by Live Photo conversion.
XHS_LIVE_PHOTO_TMP_SIZE=256m
# Application guard; keep below the tmpfs size to leave headroom.
XHS_LIVE_PHOTO_TMP_MAX_BYTES=134217728
